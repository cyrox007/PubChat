# Same-origin is the default browser/security contract. Vite dev/preview
# proxies /api to PUBCHAT_DEV_BACKEND (http://127.0.0.1:9000 by default).
VITE_API_BASE_URL=/api
# Leave empty for same-origin WebSocket derivation through /api.
VITE_API_WS_SERVER_URL=

# WebRTC ICE servers as JSON. For reliable production calling, deploy a TURN
# relay in addition to STUN; keep real TURN credentials in deployment secrets.
VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
