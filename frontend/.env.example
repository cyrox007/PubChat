# Same-origin is the default browser/security contract. Vite dev/preview
# proxies /api to PUBCHAT_DEV_BACKEND (http://127.0.0.1:9000 by default).
VITE_API_BASE_URL=/api
# Leave empty for same-origin WebSocket derivation through /api.
VITE_API_WS_SERVER_URL=

# WebRTC ICE configuration is fetched from authenticated /calls/v1/ice-config.
# Do not place long-lived TURN usernames/passwords in VITE_* variables: frontend
# build-time environment values are delivered to and readable by browsers.
